<?xml version="1.0" encoding="UTF-8"?>
<!--
  kernel.xml — Vitis contract of the gemm_kernel kernel (P4).
  Tells the XRT host the kernel name, its control protocol, its arguments,
  their SIZE and OFFSET in the AXI-Lite register file, and which memory port
  each pointer uses. The offsets MUST match the register map in
  rtl/gemm_kernel.sv:
     0x00 ap_ctrl (ap_start/ap_done/ap_idle)   ← ap_ctrl_hs, not an argument
     0x10 a_addr[31:0] / 0x14 a_addr[63:32]     ← arg a  (64-bit pointer)
     0x1C b_addr[31:0] / 0x20 b_addr[63:32]     ← arg b
     0x28 c_addr[31:0] / 0x2C c_addr[63:32]     ← arg c
     0x34 k_dim                                 ← arg k_dim (32-bit scalar)

  addressQualifier: 1 = pointer into global memory (goes through m_axi_gmem),
                    0 = scalar (lives only in the s_axi_control register).
  hwControlProtocol=ap_ctrl_hs → XRT pulses ap_start and polls ap_done (0x00).
  ⚠️ The kernel.xml format/version depends on the Vitis version — check UG1393.
-->
<root versionMajor="1" versionMinor="6">
  <kernel name="gemm_kernel" language="ip_c"
          vlnv="user.org:user:gemm_kernel:1.0"
          attributes="" preferredWorkGroupSizeMultiple="0" workGroupSize="1"
          interrupt="false" hwControlProtocol="ap_ctrl_hs">
    <ports>
      <!-- AXI4-Lite control: argument registers + ap_ctrl. range = register map size. -->
      <port name="s_axi_control" mode="slave"  range="0x1000"
            dataWidth="32" portType="addressable" base="0x0"/>
      <!-- AXI4 master into global memory (HBM/DDR). dataWidth=32 = our AXI_DW. -->
      <port name="m_axi_gmem"    mode="master" range="0xFFFFFFFFFFFFFFFF"
            dataWidth="32" portType="addressable" base="0x0"/>
    </ports>
    <args>
      <arg name="a"     addressQualifier="1" id="0" port="m_axi_gmem"
           size="0x8" offset="0x10" hostOffset="0x0" hostSize="0x8" type="char*"/>
      <arg name="b"     addressQualifier="1" id="1" port="m_axi_gmem"
           size="0x8" offset="0x1C" hostOffset="0x0" hostSize="0x8" type="char*"/>
      <arg name="c"     addressQualifier="1" id="2" port="m_axi_gmem"
           size="0x8" offset="0x28" hostOffset="0x0" hostSize="0x8" type="int*"/>
      <arg name="k_dim" addressQualifier="0" id="3" port="s_axi_control"
           size="0x4" offset="0x34" hostOffset="0x0" hostSize="0x4" type="uint"/>
    </args>
  </kernel>
</root>
